---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Privacy - Doclira PDF" description="Privacy information for Doclira PDF local desktop PDF processing.">
  <Header />
  <main class="policy-page">
    <section class="policy-hero">
      <p class="kicker">PRIVACY</p>
      <h1>Your documents stay local</h1>
      <p>Doclira PDF is a Windows desktop tool built for document work on your own computer.</p>
    </section>
    <section class="policy-content">
      <article>
        <h2>Document processing</h2>
        <p>Watermarking, conversion, page organization, compression and lightweight text operations run locally on your device. The application is not presented as a cloud document-processing service.</p>
      </article>
      <article>
        <h2>Support requests</h2>
        <p>If you contact support, only send files or screenshots needed to explain the issue. Do not send sensitive contracts or identity documents unless you have removed confidential information.</p>
      </article>
      <article>
        <h2>Purchases</h2>
        <p>Purchases and digital delivery are processed through Gumroad. Its checkout and receipt handling are subject to Gumroad's applicable privacy and payment practices.</p>
      </article>
    </section>
  </main>
  <Footer />
</Layout>

