---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { brand } from "../../brand.js";

const features = [
  ["批量加水印", "给多个 PDF 添加文字或 Logo 水印，支持透明度、旋转、平铺和指定输出目录。"],
  ["PDF 转 Word / 图片", "普通文字型 PDF 可导出为 DOCX，也可以把页面导出为 PNG 图片。"],
  ["压缩、合并、拆分", "适合邮件附件、系统上传、资料整理和日常办公归档。"],
  ["AI 文档助手", "对可提取文字的 PDF 进行总结、翻译、提问和信息提取，按 AI 点数消耗。"],
  ["轻量文字处理", "适合日期、姓名、编号、备注这类小范围补充和修正。"],
  ["本地优先", "水印、转换、压缩、合并拆分等核心处理在 Windows 本机完成。"],
];

const specs = [
  ["系统", "Windows 10 / 11，64 位"],
  ["安装包", "从官网下载或 Release 下载"],
  ["购买", "Gumroad 购买激活码，不是购买安装包"],
  ["AI", "需要联网，并消耗 AI 点数余额"],
  ["适合", "办公室 PDF 批量处理、资料整理、合同水印和轻量转换"],
  ["边界", "不是 Acrobat / UPDF 级复杂视觉 PDF 编辑器"],
];

const faq = [
  ["购买后得到什么？", "购买后得到 License Key。安装包可以先从官网下载，付款只是用于激活付费方案。"],
  ["AI 点数是每月刷新吗？", "不是。当前设计是一次性点数余额，用完后可以单独购买 AI 点数包。"],
  ["会上传我的 PDF 吗？", "水印、转换、压缩、合并拆分等核心功能在本机处理。只有主动使用 AI 时，会发送提取出的文字内容。"],
  ["能像 Word 一样编辑所有 PDF 吗？", "不能承诺所有 PDF 都自然编辑。Doclira 更适合批量水印、转换、压缩、整理、AI 辅助和少量文字处理。"],
];
---

<Layout
  lang="zh-CN"
  title="Doclira PDF - Windows PDF 办公工具"
  description="Doclira PDF 是面向 Windows 的 PDF 工具，支持批量水印、转换、压缩、合并拆分、轻量文字处理和 AI 文档助手。"
>
  <Header locale="zh" />
  <main>
    <section class="hero">
      <div class="hero-media">
        <div class="product-showcase" aria-label="Doclira PDF 产品流程预览">
          <div class="showcase-top"><span>Doclira PDF</span><strong>Batch tools</strong></div>
          <div class="showcase-body">
            <aside><b>Files</b><span>contract.pdf</span><span>report.pdf</span><span>invoice.pdf</span></aside>
            <section>
              <p class="doc-title">Internal review document</p>
              <div class="doc-line wide"></div>
              <div class="doc-line"></div>
              <div class="doc-table"><span></span><span></span><span></span></div>
              <p class="watermark-word">CONFIDENTIAL</p>
            </section>
            <aside><b>Output</b><span>Watermark</span><span>Convert</span><span>Compress</span></aside>
          </div>
        </div>
        <p class="media-caption">安装包可先下载，购买只用于激活付费功能。</p>
      </div>
      <div class="hero-content">
        <p class="kicker">WINDOWS PDF TOOLKIT</p>
        <h1>把重复的 PDF 办公工作集中到一个工具里完成。</h1>
        <p class="hero-copy">Doclira PDF 适合批量加水印、PDF 转 Word/图片、压缩、合并拆分、轻量文字处理和 AI 文档问答。核心 PDF 处理优先在本机完成。</p>
        <div class="actions">
          <a class="primary" href="/zh/download/">下载安装包</a>
          <a class="secondary" href="/zh/buy/">购买激活码</a>
        </div>
        <div class="requirements">
          <span>{brand.platform}</span>
          <span>本地 PDF 处理</span>
          <span>激活码解锁付费方案</span>
        </div>
      </div>
    </section>

    <section class="trust">
      <span>先安装再激活</span>
      <span>AI 点数可单独购买</span>
      <span>7 天退款审核</span>
      <span>清楚说明能力边界</span>
    </section>

    <section id="features" class="band">
      <div class="section-head">
        <p class="kicker">核心功能</p>
        <h2>围绕日常办公 PDF 任务设计</h2>
        <p class="intro">不承诺替代所有专业 PDF 编辑器，重点把高频、重复、批量的工作做稳。</p>
      </div>
      <div class="feature-grid six">
        {features.map(([title, text], index) => (
          <article>
            <span class="feature-index">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="examples" class="examples clean-examples">
      <div class="section-head">
        <p class="kicker">工作流程</p>
        <h2>选择文件、选择任务、检查输出</h2>
        <p class="intro">Doclira 的商业价值来自清楚的批量处理流程，而不是复杂但不稳定的视觉编辑承诺。</p>
      </div>
      <div class="proof-layout">
        <div class="workflow-visual" aria-label="Doclira PDF 工作流程">
          <div><span>1</span><strong>添加 PDF</strong><p>选择一个或多个文件。</p></div>
          <div><span>2</span><strong>选择任务</strong><p>水印、转换、压缩或整理。</p></div>
          <div><span>3</span><strong>保存输出</strong><p>在本机检查生成结果。</p></div>
        </div>
        <div class="proof-copy">
          <h3>适合真实办公场景</h3>
          <p>合同、报价单、内部资料、报告、表单和上传材料，经常需要批量处理。Doclira 把这些动作放进一个 Windows 工具里，降低重复操作。</p>
          <ul>
            <li>默认保留原文件，生成新文件。</li>
            <li>批量处理前可以看到文件列表。</li>
            <li>AI 用完可以单独购买点数包。</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="specs" class="specs">
      <div class="section-head">
        <p class="kicker">购买前说明</p>
        <h2>知道自己买的是什么</h2>
      </div>
      <div class="spec-grid">
        {specs.map(([label, value]) => <div><span>{label}</span><strong>{value}</strong></div>)}
      </div>
    </section>

    <section id="pricing" class="pricing">
      <div>
        <p class="kicker">授权方案</p>
        <h2>下载安装包免费，付费用于激活功能</h2>
        <p class="pricing-note">Gumroad 负责付款和 License Key 交付。你可以先下载安装包，再决定是否购买激活码。</p>
      </div>
      <div class="plans">
        {brand.pricing.map((plan) => (
          <article class={`plan-card ${plan.highlight ? "highlight" : ""}`}>
            {plan.highlight && <span class="plan-badge">推荐</span>}
            <h3>{plan.name}</h3>
            <p class="plan-price">{plan.price}</p>
            <p>{plan.audience}</p>
            <strong>{plan.ai}</strong>
            <ul>{plan.features.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
      <a class="primary wide" href="/zh/buy/">查看购买方式</a>
    </section>

    <section class="faq">
      <div class="section-head">
        <p class="kicker">常见问题</p>
        <h2>减少购买前疑问</h2>
      </div>
      <div class="faq-list">
        {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>
  </main>
  <Footer locale="zh" />
</Layout>
