---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { brand } from "../../brand.js";

const features = [
  ["发票和流水转 CSV", "提取可读取 PDF 中的表格、明细、金额和字段，生成可用 Excel 打开的 CSV。"],
  ["敏感信息脱敏", "识别邮箱、手机号、证件号、银行卡号、金额和地址，发送文件前进行检查和遮盖。"],
  ["PDF 安全审计", "检查元数据、链接、批注、表单、脚本和附件，降低对外发送文件的风险。"],
  ["批量办公处理", "批量水印、转 Word、转图片、压缩、合并和拆分，集中处理重复文件。"],
];

const workflows = [
  ["处理发票", "把发票 PDF 明细导出到 CSV，再到 Excel 中复核，不必逐行录入。"],
  ["处理银行流水", "把可读取的流水表格转换成 CSV，用于对账、归档和财务整理。"],
  ["发送敏感文件", "在合同、表单和客户资料发出前执行脱敏、安全审计和水印。"],
];

const planCopy = {
  Pro: ["PDF 转 CSV、Word 和图片", "压缩、合并、拆分和水印", "核心 PDF 工具本机处理", "包含 50 AI 点数"],
  Business: ["包含 Pro 全部功能", "智能敏感信息脱敏", "重复文件批量处理", "商业使用授权", "包含 200 AI 点数"],
  Enterprise: ["包含 Business 全部功能", "完整 PDF 安全审计", "检查元数据、链接、表单、脚本和附件", "包含 500 AI 点数"],
};

const faq = [
  ["文件会上传到服务器吗？", "PDF 转换、表格提取、脱敏、水印、压缩、合并拆分等核心处理在本机执行。只有主动使用 AI 功能时，才会发送提取后的文本。"],
  ["这是订阅制吗？", "不是。当前套餐是一次性 Windows 授权，附带的 AI 点数也是一次性余额，不按月自动扣费。"],
  ["扫描版 PDF 能直接转 CSV 吗？", "当前表格提取更适合可选择文字的 PDF。扫描件需要先 OCR，复杂表格仍应人工复核。"],
  ["能像 Word 一样修改任意 PDF 吗？", "不能。Doclira 更适合数据提取、隐私处理、批量办公和简单文字修正，不定位为复杂排版设计工具。"],
];
---

<Layout
  lang="zh-CN"
  title="Doclira PDF - 本地 PDF 转 Excel、脱敏与批量处理工具"
  description="在 Windows 本机把发票、银行流水和 PDF 表格转成 CSV，并完成敏感信息脱敏、安全审计、水印和批量处理。"
>
  <Header locale="zh" />
  <main>
    <section class="hero">
      <div class="hero-media">
        <img src="/assets/hero_redaction_en.png" alt="Doclira PDF 敏感信息脱敏界面" />
      </div>
      <div class="hero-content">
        <p class="kicker">WINDOWS 本地 PDF 数据工作台</p>
        <h1>把敏感 PDF 变成可用数据，文件仍留在你的电脑里。</h1>
        <p class="hero-copy">将发票、银行流水和表格 PDF 导出为可复核的 CSV；发送文件前完成敏感信息脱敏、安全审计和批量处理。</p>
        <div class="actions">
          <a class="primary hero-primary" href="/download/">免费下载 Windows 版</a>
          <a class="secondary" href="#pricing">查看 $29 起套餐</a>
        </div>
        <div class="requirements">
          <span>先试用再购买</span>
          <span>核心功能本机处理</span>
          <span>Windows 10 / 11 64 位</span>
          <span>一次性授权</span>
        </div>
      </div>
    </section>

    <section class="problem-strip" aria-label="常用 PDF 工作流">
      {workflows.map(([title, text]) => (
        <article>
          <strong>{title}</strong>
          <p>{text}</p>
        </article>
      ))}
    </section>

    <section id="features" class="band">
      <div class="section-head">
        <p class="kicker">核心功能</p>
        <h2>围绕数据提取、隐私处理和批量交付</h2>
        <p class="intro">Doclira 不只是堆放 PDF 小工具，而是帮助你完成从原始文件到可用数据、再到安全交付的完整流程。</p>
      </div>
      <div class="feature-grid">
        {features.map(([title, text], index) => (
          <article>
            <span class="feature-index">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="pricing" class="band pricing-section">
      <div class="section-head">
        <p class="kicker">一次性 WINDOWS 授权</p>
        <h2>$29 起，按文件风险和工作量选择</h2>
        <p class="intro">Pro 适合个人转换；Business 增加智能脱敏和商业工作流；Enterprise 增加完整 PDF 安全审计。</p>
      </div>
      <div class="tier-grid">
        {brand.pricing.map((plan) => (
          <article class:list={["tier-card", plan.highlight && "highlight"]}>
            {plan.highlight && <span class="tier-badge">推荐套餐</span>}
            <h3>{plan.name}</h3>
            <p class="tier-price">{plan.price}</p>
            <p class="one-time">一次性授权</p>
            <ul>
              {planCopy[plan.name].map((feature) => <li>{feature}</li>)}
            </ul>
            <a class="primary wide" href="/buy/">查看套餐详情</a>
          </article>
        ))}
      </div>
    </section>

    <section id="faq" class="faq">
      <div class="section-head">
        <p class="kicker">常见问题</p>
        <h2>功能边界和付费方式说清楚</h2>
      </div>
      <div class="faq-grid">
        {faq.map(([question, answer]) => <article><h3>{question}</h3><p>{answer}</p></article>)}
      </div>
    </section>
  </main>
  <Footer locale="zh" />
</Layout>
