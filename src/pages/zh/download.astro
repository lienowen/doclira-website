---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { brand } from "../../brand.js";

const downloads = [
  {
    name: "Doclira PDF Lite",
    tag: "免费",
    platform: "Windows 10 / 11，64 位",
    bestFor: "先体验基础界面和 PDF 工作流。",
    delivery: "公开 GitHub 仓库",
    action: "下载 Lite",
    href: brand.liteUrl,
    primary: true,
  },
  {
    name: "Doclira PDF Pro",
    tag: brand.price,
    platform: "Windows 10 / 11，64 位",
    bestFor: "日常 PDF 办公、批量处理和 AI 文档辅助。",
    delivery: "Gumroad 付款后交付安装包和 License Key",
    action: "购买 Pro",
    href: brand.purchaseUrl,
  },
  {
    name: "使用指南",
    tag: "指南",
    platform: "在线查看",
    bestFor: "安装、激活和常用功能操作步骤。",
    delivery: "官网指南",
    action: "打开指南",
    href: "/zh/guide/",
  },
];
---

<Layout
  lang="zh-CN"
  title="下载 Doclira PDF - Windows PDF 工具"
  description="下载 Doclira PDF Lite，购买完整 Windows 版本，或查看使用指南。"
>
  <Header locale="zh" />
  <main class="download-page">
    <section class="download-hero">
      <p class="kicker">下载</p>
      <h1>下载 Doclira PDF</h1>
      <p>选择免费 Lite 版、购买完整 Windows 工具，或打开使用指南。</p>
    </section>

    <section class="download-list" aria-label="Doclira PDF 下载选项">
      {downloads.map((item) => (
        <article class="download-row">
          <div>
            <span class="download-tag">{item.tag}</span>
            <h2>{item.name}</h2>
            <p>{item.bestFor}</p>
          </div>
          <div>
            <span>系统</span>
            <strong>{item.platform}</strong>
          </div>
          <div>
            <span>交付方式</span>
            <strong>{item.delivery}</strong>
          </div>
          <a class={item.primary ? "primary" : "secondary"} href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noreferrer" : undefined}>{item.action}</a>
        </article>
      ))}
    </section>

    <section class="download-note">
      <h2>建议先这样做</h2>
      <p>新用户建议先用 Lite 版测试非敏感 PDF。如果这个流程适合你的日常办公，再购买付费版用于商业工作、批量处理和 AI 点数。</p>
    </section>
  </main>
  <Footer locale="zh" />
</Layout>
