---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { brand } from "../brand.js";

const features = [
  ["Batch watermark", "Add text or logo watermarks to selected PDFs with tiling, opacity, rotation and page range control."],
  ["PDF to Word and images", "Convert ordinary text PDFs to DOCX, or export every page as a clear PNG for sharing and uploads."],
  ["Compress and organize", "Reduce file size, merge documents, split pages and combine images into PDFs from one file list."],
  ["Light PDF text correction", "Replace short fields or add small notes while saving a new PDF, useful for dates, names and brief corrections."],
  ["AI document help", "Summarize, translate, polish or ask questions about selectable PDF text with plan-based AI allowances."],
  ["Local-first workflow", "Most PDF processing runs on your Windows computer. You choose the output folder before processing."],
];

const proofPoints = [
  "Real Windows app screenshots, not abstract mockups",
  "Free open-source Lite edition to inspect the basic workflow",
  "7-day refund policy for installation and advertised feature issues",
  "Clear limitations for complex layouts and scanned documents",
];

const useCases = [
  ["Contracts and review copies", "Add clear ownership or confidential watermarks before sending files outside your team."],
  ["Office uploads and portals", "Compress PDFs or export pages as PNG files when a system has strict upload requirements."],
  ["Reusable document text", "Convert ordinary text PDFs into Word when you need to copy, revise or continue editing."],
  ["Small corrections", "Fix a date, customer name, project code or short note without rebuilding the whole PDF."],
];

const specs = [
  ["System", "Windows 10 / 11, 64-bit"],
  ["Delivery", "Windows installer and license key through Gumroad"],
  ["Local tasks", "Watermark, conversion, compression, merge, split and image export"],
  ["AI tasks", "Requires internet and uses extracted PDF text"],
  ["Best fit", "Recurring office PDF work and batch processing"],
  ["Limitations", "Not a full Acrobat or UPDF replacement for complex visual PDF editing"],
];

const faq = [
  ["Does Doclira upload my PDFs?", "Core tasks such as watermarking, conversion, compression, merge and split run locally. AI features send extracted text to the AI service only when you use AI."],
  ["Can it edit every PDF like Word?", "No. It supports lightweight PDF text corrections. Complex design-heavy PDFs, unusual fonts and scanned files may require conversion to Word, OCR or manual cleanup."],
  ["What do I receive after purchase?", "Gumroad delivers the Windows installer and a license key. Open the app, enter the key and the purchased plan is unlocked."],
  ["Which Windows versions are supported?", "Windows 10 and Windows 11 on 64-bit systems."],
];
---

<Layout
  title="Doclira PDF - Commercial Windows PDF Toolkit"
  description="A Windows PDF toolkit for batch watermarking, conversion, compression, page organization, light text correction and AI document help."
>
  <Header />
  <main>
    <section class="hero">
      <div class="hero-media">
        <img src="/media/doclira_app_watermark_result_en.png" alt="Doclira PDF Windows app showing a protected PDF with tiled watermark" />
        <p class="media-caption">Actual app screen: a PDF protected with a tiled internal-use watermark.</p>
      </div>
      <div class="hero-content">
        <p class="kicker">WINDOWS PDF TOOLKIT FOR REAL OFFICE WORK</p>
        <h1>Handle repeat PDF jobs without opening five different tools.</h1>
        <p class="hero-copy">Doclira PDF helps you watermark, convert, compress, merge, split and lightly correct PDFs on Windows, with optional AI help for document text.</p>
        <div class="actions">
          <a class="primary" href={brand.purchaseUrl} target="_blank" rel="noreferrer">Buy from {brand.price}</a>
          <a class="secondary" href={brand.liteUrl} target="_blank" rel="noreferrer">Download free Lite</a>
        </div>
        <div class="requirements">
          <span>{brand.platform}</span>
          <span>Local PDF processing</span>
          <span>License key delivery</span>
        </div>
      </div>
    </section>

    <section class="trust">
      {proofPoints.map((point) => <span>{point}</span>)}
    </section>

    <section id="features" class="band">
      <div class="section-head">
        <p class="kicker">WHAT IT DOES</p>
        <h2>Useful PDF tools with clear boundaries</h2>
        <p class="intro">Doclira focuses on common business PDF tasks, especially batch processing and visible output control.</p>
      </div>
      <div class="feature-grid six">
        {features.map(([title, text], index) => (
          <article>
            <span class="feature-index">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="examples" class="examples clean-examples">
      <div class="section-head">
        <p class="kicker">REAL APP EVIDENCE</p>
        <h2>Show the product working, then keep the page calm</h2>
        <p class="intro">A few clear visuals are more convincing than a wall of comparison graphics.</p>
      </div>
      <div class="proof-layout">
        <figure class="proof-large">
          <img src="/media/doclira_app_watermark_result_en.png" alt="Doclira PDF app showing a watermarked PDF output" />
          <figcaption>Generated output preview inside the Windows app</figcaption>
        </figure>
        <div class="proof-copy">
          <h3>Built around visible output</h3>
          <p>Users choose files, choose the output folder, run the task and review the generated result. This is the workflow that matters for daily office PDF work.</p>
          <ul>
            <li>Watermark and output files stay easy to verify.</li>
            <li>Original files are kept unless the user chooses otherwise.</li>
            <li>Batch tasks show selected files before processing.</li>
          </ul>
        </div>
      </div>
      <div class="demo-list minimal">
        <article class="demo-row featured">
          <div class="demo-content">
            <p class="demo-index">01 / BATCH PROTECTION</p>
            <h3>Add tiled text or logo watermarks</h3>
            <p>Protect review copies, internal material and shared documents with visible ownership marks.</p>
            <div class="demo-tags"><span>Clean PDF</span><strong>Watermark</strong><span>Protected PDF</span></div>
          </div>
          <img src="/assets/demo_watermark_en.png" alt="PDF before and after tiled watermark" />
        </article>
        <article class="demo-row">
          <div class="demo-content">
            <p class="demo-index">02 / EDITABLE OUTPUT</p>
            <h3>Convert ordinary PDFs to Word</h3>
            <p>Export text-based PDFs to DOCX for reuse. Complex scans or unusual layouts should be reviewed after conversion.</p>
            <div class="demo-tags"><span>PDF</span><strong>Convert</strong><span>DOCX</span></div>
          </div>
          <img src="/assets/demo_pdf_to_word_en.png" alt="PDF converted into Word document output" />
        </article>
      </div>
    </section>

    <section id="use-cases" class="use-cases">
      <div class="section-head">
        <p class="kicker">WHERE IT FITS</p>
        <h2>For repeat PDF work, not one-off perfection promises</h2>
        <p class="intro">Doclira is positioned as a practical local workflow tool for people who handle PDFs often.</p>
      </div>
      <div class="use-case-grid">
        {useCases.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
      </div>
    </section>

    <section id="walkthrough" class="app-demo">
      <div class="section-head">
        <p class="kicker">PRODUCT WALKTHROUGH</p>
        <h2>See the watermark workflow in the actual Windows app</h2>
        <p class="intro">The short video shows opening a sample PDF, configuring a tiled watermark and checking the generated result.</p>
      </div>
      <video class="walkthrough-video" controls playsinline preload="metadata" poster="/media/doclira_app_watermark_result_en.png">
        <source src="/media/doclira_watermark_tutorial_en_1920x1080_voice.mp4" type="video/mp4" />
        Your browser does not support embedded video.
      </video>
      <div class="app-shot-grid">
        <figure>
          <img src="/media/doclira_app_source_document_en.png" alt="Source PDF opened inside Doclira PDF" loading="lazy" />
          <figcaption>Open and preview the source PDF</figcaption>
        </figure>
        <figure>
          <img src="/media/doclira_app_watermark_settings_en.png" alt="Batch watermark settings in Doclira PDF" loading="lazy" />
          <figcaption>Choose watermark options before output</figcaption>
        </figure>
      </div>
    </section>

    <section id="editions" class="editions">
      <div class="section-head">
        <p class="kicker">FREE LITE VS PAID PLANS</p>
        <h2>Try the basics before buying the commercial edition</h2>
        <p class="intro">Lite is a public starter edition. Paid plans unlock the commercial workflow, advanced batch tools and AI allowance.</p>
      </div>
      <div class="compare-table" role="table" aria-label="Doclira Lite and Pro comparison">
        <div class="compare-row compare-head" role="row"><span>Capability</span><strong>Free Lite</strong><strong>Paid plans</strong></div>
        <div class="compare-row" role="row"><span>Preview and basic page organization</span><strong>Included</strong><strong>Included</strong></div>
        <div class="compare-row" role="row"><span>Single-file basic watermark</span><strong>Included</strong><strong>Included</strong></div>
        <div class="compare-row" role="row"><span>Advanced batch watermark, conversion and output workflow</span><strong>-</strong><strong>Included</strong></div>
        <div class="compare-row" role="row"><span>AI document help and commercial license</span><strong>-</strong><strong>Included</strong></div>
      </div>
    </section>

    <section id="specs" class="specs">
      <div class="section-head">
        <p class="kicker">TECH SPECS</p>
        <h2>Know exactly what you are buying</h2>
      </div>
      <div class="spec-grid">
        {specs.map(([label, value]) => <div><span>{label}</span><strong>{value}</strong></div>)}
      </div>
    </section>

    <section id="pricing" class="pricing">
      <div>
        <p class="kicker">LICENSE PLANS</p>
        <h2>Choose a plan by usage, not by mystery features</h2>
        <p class="pricing-note">Secure checkout and license key delivery are handled by Gumroad. All plans support Windows 10 / 11 64-bit.</p>
      </div>
      <div class="plans">
        {brand.pricing.map((plan) => (
          <article class={`plan-card ${plan.highlight ? "highlight" : ""}`}>
            {plan.highlight && <span class="plan-badge">Recommended</span>}
            <h3>{plan.name}</h3>
            <p class="plan-price">{plan.price}</p>
            <p>{plan.audience}</p>
            <strong>{plan.ai}</strong>
            <ul>{plan.features.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
      <a class="primary wide" href={brand.purchaseUrl} target="_blank" rel="noreferrer">Purchase on Gumroad</a>
    </section>

    <section id="faq" class="faq">
      <div class="section-head">
        <p class="kicker">BEFORE YOU BUY</p>
        <h2>Clear expectations reduce refunds</h2>
      </div>
      <div class="faq-grid">
        {faq.map(([question, answer]) => <article><h3>{question}</h3><p>{answer}</p></article>)}
      </div>
      <div class="trust-strip">
        <span>7-day refund policy</span>
        <span>Installer and activation key after purchase</span>
        <span>Support: {brand.supportEmail}</span>
        <span>Complex PDFs may need review</span>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
