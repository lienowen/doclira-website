---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { brand } from "../brand.js";

const features = [
  ["Extract data", "Turn readable invoice, statement and table PDFs into CSV you can review in Excel."],
  ["Remove sensitive details", "Find and permanently redact personal information before a document is shared."],
  ["Prepare files in batches", "Watermark, convert, compress, merge and split repeated office documents locally."],
];

const steps = [
  "Download the installer from doclira.com.",
  "Open an invoice, statement, form, contract or select multiple files for batch work.",
  "Run table extraction, watermark, convert, compress, merge, split, redact or AI tools.",
  "Save new output files so the original documents stay untouched.",
];

const faq = [
  ["Is this a subscription?", "No. Doclira is positioned as a one-time Windows license. AI credits are a visible usage balance."],
  ["Are my PDFs uploaded?", "Core PDF tasks run locally on your computer. AI features send extracted text only when you choose to use AI."],
  ["Can it edit any PDF like Word?", "No. Doclira is best for practical office tasks, light corrections and conversion workflows, not complex visual PDF redesign."],
  ["What happens after purchase?", "Gumroad delivers an activation key. Download the installer from the website, then activate the app."],
];

---

<Layout
  title="Doclira PDF - Offline PDF to Excel, Redaction and Batch Tools for Windows"
  description="Convert PDF invoices, bank statements and tables to CSV locally on Windows. Redact sensitive data, audit PDFs, watermark, compress, merge and split files."
>
  <Header />
  <main>
    <section class="hero">
      <div class="hero-media">
        <img src="/assets/hero_redaction_en.png" alt="Doclira PDF smart redaction preview" />
      </div>
      <div class="hero-content">
        <p class="kicker">LOCAL PDF DATA WORKSPACE FOR WINDOWS</p>
        <h1>Get usable data from sensitive PDFs.</h1>
        <p class="hero-copy">A local Windows workspace for PDF-to-CSV extraction, permanent redaction and repeated office document processing.</p>
        <div class="actions">
          <a class="primary hero-primary" href="/download/">Download free for Windows</a>
          <a class="secondary" href="#pricing">See plans from $29</a>
        </div>
        <div class="requirements">
          <span>Try before buying</span>
          <span>Core tools run locally</span>
          <span>{brand.platform}</span>
          <span>One-time license</span>
        </div>
      </div>
    </section>

    <section id="features" class="band">
      <div class="section-head">
        <p class="kicker">FEATURES</p>
        <h2>One workspace. Three clear outcomes.</h2>
        <p class="intro">Start with the result you need instead of searching through a wall of PDF tools.</p>
      </div>
      <div class="feature-grid">
        {features.map(([title, text], index) => (
          <article>
            <span class="feature-index">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    {brand.youtubeVideoId && (
      <section id="demo" class="band">
        <div class="section-head">
          <p class="kicker">SEE IT IN ACTION</p>
          <h2>Watch the walkthrough</h2>
          <p class="intro">See the local workflow before installing.</p>
        </div>
        <div class="video-wrapper">
          <iframe width="100%" height="450" src={`https://www.youtube.com/embed/${brand.youtubeVideoId}`} title="Doclira PDF demo" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </section>
    )}

    <section id="workflow" class="workflow">
      <div class="section-head">
        <p class="kicker">WORKFLOW</p>
        <h2>From source file to output in four steps</h2>
      </div>
      <ol>
        {steps.map((step, index) => <li><span>{index + 1}</span><p>{step}</p></li>)}
      </ol>
      <a class="text-link" href="/guide/">Read the full user guide</a>
    </section>

    <section id="pricing" class="band pricing-section">
      <div class="section-head">
        <p class="kicker">ONE-TIME WINDOWS LICENSES</p>
        <h2>Start at $29. Pay more only when the workflow carries more risk.</h2>
        <p class="intro">Pro covers everyday conversion. Business adds redaction and repeated client work. Enterprise adds deeper security review. AI credits are included once, not billed monthly.</p>
      </div>
      <div class="tier-grid">
        {brand.pricing.map((plan) => (
          <article class:list={["tier-card", plan.highlight && "highlight"]}>
            {plan.highlight && <span class="tier-badge">{plan.badge}</span>}
            <h3>{plan.name}</h3>
            <p class="plan-audience">{plan.audience}</p>
            <p class="tier-price">{plan.price}</p>
            <p class="one-time">One-time license</p>
            <ul>
              {plan.features.map((feature) => <li>{feature}</li>)}
              <li>{plan.ai}</li>
            </ul>
            <a class="primary wide" href="/buy/">{plan.cta}</a>
          </article>
        ))}
      </div>
      <p class="pricing-footnote">Download and test first. Gumroad delivers the activation key after purchase.</p>
    </section>

    <section id="faq" class="faq">
      <div class="section-head">
        <p class="kicker">FAQ</p>
        <h2>Clear expectations, fewer surprises</h2>
      </div>
      <div class="faq-grid">
        {faq.map(([question, answer]) => <article><h3>{question}</h3><p>{answer}</p></article>)}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
