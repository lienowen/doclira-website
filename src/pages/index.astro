---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { brand } from "../brand.js";

const features = [
  ["Invoices to CSV", "Extract line items, quantities, prices and totals from supplier and customer invoices."],
  ["Bank statements to CSV", "Turn transaction rows into structured data for bookkeeping and categorization."],
  ["Monthly reconciliation", "Review balances and transaction details before moving clean data into Excel."],
];

const steps = [
  "Download the installer from doclira.com.",
  "Open an invoice, statement, form, contract or select multiple files for batch work.",
  "Run table extraction, watermark, convert, compress, merge, split, redact or AI tools.",
  "Save new output files so the original documents stay untouched.",
];

const faq = [
  ["Is this a subscription?", "No. Doclira is positioned as a one-time Windows license. AI credits are a visible usage balance."],
  ["Are my PDFs uploaded?", "Core PDF tasks run locally on your computer. AI features send extracted text only when you choose to use AI."],
  ["Can it edit any PDF like Word?", "No. Doclira is best for practical office tasks, light corrections and conversion workflows, not complex visual PDF redesign."],
  ["What happens after purchase?", "Gumroad delivers an activation key. Download the installer from the website, then activate the app."],
];

---

<Layout
  title="Doclira PDF - Invoice and Bank Statement PDF to CSV for Windows"
  description="Extract invoice, bank statement and financial table data from PDF to reviewable CSV locally on Windows."
>
  <Header />
  <main>
    <section class="hero finance-hero">
      <div class="hero-content">
        <p class="kicker">FOR ACCOUNTANTS &amp; BOOKKEEPERS</p>
        <h1>Stop retyping invoices and bank statements.</h1>
        <p class="hero-copy">Turn financial PDFs into Excel-ready data you can review before export. Sensitive source files stay on your Windows computer.</p>
        <div class="actions">
          <a class="primary hero-primary" href="/download/">Download free for Windows</a>
          <a class="secondary" href="#pricing">See plans from $29</a>
        </div>
        <p class="hero-meta">{brand.platform} <span>•</span> One-time license</p>
        <div class="hero-trust">
          <div><strong>Runs locally</strong><span>Files never leave your computer</span></div>
          <div><strong>Review first</strong><span>Correct cells before export</span></div>
          <div><strong>Your data stays yours</strong><span>No cloud document storage</span></div>
        </div>
      </div>
      <div class="hero-media finance-product">
        <img src="/assets/finance-statement-extraction.png" alt="Doclira PDF showing a bank statement beside an editable extracted data table" />
      </div>
    </section>

    <section class="outcome-strip" aria-label="Doclira finance workflow benefits">
      <div><strong>Less manual entry</strong><span>Move from copying rows to reviewing them.</span></div>
      <div><strong>Review before export</strong><span>Check every detected value in a clear grid.</span></div>
      <div><strong>Local by default</strong><span>Financial PDFs remain on your Windows PC.</span></div>
    </section>

    <section id="features" class="band finance-use-cases">
      <div class="section-head">
        <p class="kicker">BUILT FOR EVERYDAY FINANCE WORK</p>
        <h2>From document to clean data.</h2>
        <p class="intro">Use one repeatable workflow for the financial PDFs that arrive every week and every month.</p>
      </div>
      <div class="feature-grid">
        {features.map(([title, text], index) => (
          <article>
            <span class="feature-index">{index + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
            <a href={index === 0 ? "/pdf-invoice-to-excel/" : index === 1 ? "/bank-statement-pdf-to-csv/" : "/extract-tables-from-pdf/"}>Learn more</a>
          </article>
        ))}
      </div>
    </section>

    {brand.youtubeVideoId && (
      <section id="demo" class="band">
        <div class="section-head">
          <p class="kicker">SEE IT IN ACTION</p>
          <h2>See PDF data become a reviewable table</h2>
          <p class="intro">Preview the finance workflow before installing.</p>
        </div>
        <div class="video-wrapper">
          <iframe width="100%" height="450" src={`https://www.youtube.com/embed/${brand.youtubeVideoId}`} title="Doclira PDF demo" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </section>
    )}

    <section id="workflow" class="workflow">
      <div class="section-head">
        <p class="kicker">WORKFLOW</p>
        <h2>From financial PDF to reviewed CSV</h2>
      </div>
      <ol>
        {steps.map((step, index) => <li><span>{index + 1}</span><p>{step}</p></li>)}
      </ol>
      <a class="text-link" href="/guide/">Read the full user guide</a>
    </section>

    <section id="pricing" class="band pricing-section">
      <div class="section-head">
        <p class="kicker">ONE-TIME WINDOWS LICENSES</p>
        <h2>Start at $29. Upgrade when document volume and risk increase.</h2>
        <p class="intro">Pro is for individual finance work. Business adds repeated batch workflows and redaction. Enterprise adds deeper security review for sensitive financial documents.</p>
      </div>
      <div class="tier-grid">
        {brand.pricing.map((plan) => (
          <article class:list={["tier-card", plan.highlight && "highlight"]}>
            {plan.highlight && <span class="tier-badge">{plan.badge}</span>}
            <h3>{plan.name}</h3>
            <p class="plan-audience">{plan.audience}</p>
            <p class="tier-price">{plan.price}</p>
            <p class="one-time">One-time license</p>
            <ul>
              {plan.features.map((feature) => <li>{feature}</li>)}
              <li>{plan.ai}</li>
            </ul>
            <a class="primary wide" href="/buy/">{plan.cta}</a>
          </article>
        ))}
      </div>
      <p class="pricing-footnote">Download and test first. Gumroad delivers the activation key after purchase.</p>
    </section>

    <section id="faq" class="faq">
      <div class="section-head">
        <p class="kicker">FAQ</p>
        <h2>Clear expectations, fewer surprises</h2>
      </div>
      <div class="faq-grid">
        {faq.map(([question, answer]) => <article><h3>{question}</h3><p>{answer}</p></article>)}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
