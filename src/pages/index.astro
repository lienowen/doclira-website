---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { brand } from "../brand.js";

const features = [
  ["Smart redaction", "Detect and cover sensitive text patterns before sharing PDFs outside your team."],
  ["Security audit", "Check PDFs for metadata, attachments, scripts and unresolved annotations."],
  ["AI chat", "Ask questions, summarize, translate and extract key information from readable PDF text."],
  ["Batch watermark", "Add text or logo watermarks with tiling, opacity, rotation and page range controls."],
  ["PDF to Word", "Convert ordinary text-based PDFs to editable DOCX files for continued office work."],
  ["Merge, split and compress", "Combine documents, split page ranges, reduce file size and export page images."],
];

const seoPages = [
  ["Batch watermark PDF on Windows", "Protect contracts, reports and review copies with tiled text or logo watermarks.", "/batch-watermark-pdf-windows/"],
  ["PDF to Word converter for Windows", "Convert ordinary text-based PDFs into DOCX files for continued editing.", "/pdf-to-word-converter-windows/"],
  ["Compress PDF on Windows", "Reduce PDF size before email, chat, portals or internal office uploads.", "/compress-pdf-windows/"],
  ["Merge and split PDF files", "Combine documents, split page ranges and organize PDF packages.", "/merge-split-pdf-windows/"],
  ["AI PDF summary tool", "Summarize long PDFs and ask questions about extracted document text.", "/ai-pdf-summary/"],
];

const steps = [
  "Download and install the Windows app.",
  "Open one PDF or select a batch of files.",
  "Choose watermark, convert, compress, merge, split, redact or AI.",
  "Save new output files and review the result locally.",
];

const faq = [
  ["Is this a subscription?", "No. Doclira is positioned as a one-time Windows license. AI credits are a visible usage balance."],
  ["Are my PDFs uploaded?", "Core PDF tasks run locally on your computer. AI features send extracted text only when you choose to use AI."],
  ["Can it edit any PDF like Word?", "No. Doclira is best for practical office tasks, light corrections and conversion workflows, not complex visual PDF redesign."],
  ["What happens after purchase?", "Gumroad delivers an activation key. Download the installer from the website, then activate the app."],
];
---

<Layout
  title="Doclira PDF - No Subscription. Local-First PDF Toolkit for Windows"
  description="One-time purchase PDF toolkit for Windows. Watermark, redact, convert, compress, merge, split and use AI document help. Files stay on your PC."
>
  <Header />
  <main>
    <section class="hero">
      <div class="hero-media">
        <img src="/assets/hero_redaction_en.png" alt="Doclira PDF smart redaction preview" />
      </div>
      <div class="hero-content">
        <p class="kicker">{brand.tagline}</p>
        <h1>Stop Paying Adobe Every Month</h1>
        <p class="hero-copy">Watermark contracts, redact sensitive data, convert PDFs to Word, compress for email, merge and split documents, and use AI document help on your Windows PC.</p>
        <div class="actions">
          <a class="primary" href="/download/">Download free</a>
          <a class="secondary" href={brand.purchaseUrl} target="_blank" rel="noreferrer">Buy once - {brand.price}</a>
        </div>
        <div class="requirements">
          <span>Local processing</span>
          <span>{brand.platform}</span>
          <span>Activation key after purchase</span>
        </div>
      </div>
    </section>

    <section id="features" class="band">
      <div class="section-head">
        <p class="kicker">FEATURES</p>
        <h2>Tools for PDF jobs that keep coming back</h2>
        <p class="intro">Doclira focuses on repeat office PDF work: batch operations, visible output, clear limits and a simple Windows workflow.</p>
      </div>
      <div class="feature-grid">
        {features.map(([title, text], index) => (
          <article>
            <span class="feature-index">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="seo-entry band">
      <div class="section-head">
        <p class="kicker">PDF TASK GUIDES</p>
        <h2>Find the workflow that matches your problem</h2>
        <p class="intro">These pages are built for people searching for a specific PDF task on Windows.</p>
      </div>
      <div class="tool-link-grid rich">
        {seoPages.map(([title, text, href]) => (
          <a href={href}>
            <strong>{title}</strong>
            <span>{text}</span>
          </a>
        ))}
      </div>
    </section>

    {brand.youtubeVideoId && (
      <section id="demo" class="band">
        <div class="section-head">
          <p class="kicker">SEE IT IN ACTION</p>
          <h2>Watch the walkthrough</h2>
          <p class="intro">Use the video as proof on the website and as a reusable asset for SEO pages and social posts.</p>
        </div>
        <div class="video-wrapper">
          <iframe width="100%" height="450" src={`https://www.youtube.com/embed/${brand.youtubeVideoId}`} title="Doclira PDF demo" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </section>
    )}

    <section id="workflow" class="workflow">
      <div class="section-head">
        <p class="kicker">WORKFLOW</p>
        <h2>From source file to output in four steps</h2>
      </div>
      <ol>
        {steps.map((step, index) => <li><span>{index + 1}</span><p>{step}</p></li>)}
      </ol>
      <a class="text-link" href="/guide/">Read the full user guide</a>
    </section>

    <section id="pricing" class="pricing">
      <div>
        <p class="kicker">HOW PURCHASE WORKS</p>
        <h2>Download the app first. Buy the key only when you need paid tools.</h2>
        <p class="pricing-note">The installer is separate from payment. Gumroad delivers the activation key, and the app unlocks the license level and included AI credits after activation.</p>
      </div>
      <div class="purchase-flow">
        <article>
          <span>1</span>
          <h3>Free installer</h3>
          <p>Install Doclira PDF and test basic workflows on Windows before buying.</p>
          <a class="secondary wide" href="/download/">Download app</a>
        </article>
        <article>
          <span>2</span>
          <h3>Activation key</h3>
          <p>Buy once on Gumroad to unlock paid features and included AI credits.</p>
          <a class="primary wide" href={brand.purchaseUrl} target="_blank" rel="noreferrer">Buy key from {brand.price}</a>
        </article>
      </div>
    </section>

    <section id="faq" class="faq">
      <div class="section-head">
        <p class="kicker">FAQ</p>
        <h2>Clear expectations, fewer surprises</h2>
      </div>
      <div class="faq-grid">
        {faq.map(([question, answer]) => <article><h3>{question}</h3><p>{answer}</p></article>)}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
