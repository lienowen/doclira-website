---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { brand } from "../brand.js";

const features = [
  ["PDF tables to Excel / CSV", "Extract table-like data from readable PDFs and prepare office-friendly Excel or CSV output workflows."],
  ["Invoice and statement workflows", "Handle invoices, forms, statements and client files without uploading sensitive documents to random online tools."],
  ["Local-first processing", "Core PDF processing runs on your Windows computer. AI only uses extracted text when you choose AI."],
  ["Smart redaction", "Find emails, phone numbers, ID-style numbers, card-like numbers and amounts, then save a redacted copy."],
  ["Security audit", "Check PDFs for metadata, attachments, links, forms, scripts and unresolved annotations before sharing."],
  ["Batch watermark", "Add text or logo watermarks with tiling, opacity, rotation and page range controls."],
  ["Convert, merge, split, compress", "Convert ordinary PDFs to Word or images, combine documents, split page ranges and reduce file size."],
];

const seoPages = [
  ["PDF invoice to Excel", "Extract invoice tables and line-item style data from readable PDFs for office review.", "/pdf-invoice-to-excel/"],
  ["Bank statement PDF to CSV", "Prepare statement-style PDF data for CSV workflows without using online upload tools.", "/bank-statement-pdf-to-csv/"],
  ["Extract tables from PDF", "Turn readable PDF tables into spreadsheet-friendly data on Windows.", "/extract-tables-from-pdf/"],
  ["Offline PDF to Excel for Windows", "Work on sensitive PDFs locally instead of uploading them to a browser tool.", "/offline-pdf-to-excel-windows/"],
  ["Batch PDF tools for Windows", "Process many PDFs for watermarking, conversion, compression, merge and split.", "/batch-pdf-tools-windows/"],
  ["PDF redaction tool for Windows", "Find and remove sensitive information before sending contracts and client files.", "/pdf-redaction-tool-windows/"],
  ["Redact sensitive information in PDFs", "A practical workflow for emails, phone numbers, IDs, cards and amounts.", "/redact-sensitive-information-pdf/"],
  ["PDF security audit tool", "Check metadata, links, attachments, forms and annotations before sharing a PDF.", "/pdf-security-audit-tool/"],
  ["Redact PDF contracts", "Review client and vendor agreements before emailing or uploading them.", "/redact-pdf-contracts-windows/"],
  ["Redact PDF invoices", "Clean invoice PDFs, billing files and customer references before forwarding.", "/redact-pdf-invoices-windows/"],
  ["Redact PDF forms", "Check HR, tax, onboarding and customer forms for sensitive information.", "/redact-pdf-forms-windows/"],
  ["Batch watermark PDF on Windows", "Protect contracts, reports and review copies with tiled text or logo watermarks.", "/batch-watermark-pdf-windows/"],
  ["PDF to Word converter for Windows", "Convert ordinary text-based PDFs into DOCX files for continued editing.", "/pdf-to-word-converter-windows/"],
  ["Free PDF privacy checker", "Install the Windows app and test basic PDF privacy checks before buying.", "/free-pdf-privacy-checker-windows/"],
  ["Compress PDF on Windows", "Reduce PDF size before email, chat, portals or internal office uploads.", "/compress-pdf-windows/"],
  ["Merge and split PDF files", "Combine documents, split page ranges and organize PDF packages.", "/merge-split-pdf-windows/"],
  ["AI PDF summary tool", "Summarize long PDFs and ask questions about extracted document text.", "/ai-pdf-summary/"],
];

const steps = [
  "Download the installer from doclira.com.",
  "Open an invoice, statement, form, contract or select multiple files for batch work.",
  "Run table extraction, watermark, convert, compress, merge, split, redact or AI tools.",
  "Save new output files so the original documents stay untouched.",
];

const faq = [
  ["Is this a subscription?", "No. Doclira is positioned as a one-time Windows license. AI credits are a visible usage balance."],
  ["Are my PDFs uploaded?", "Core PDF tasks run locally on your computer. AI features send extracted text only when you choose to use AI."],
  ["Can it edit any PDF like Word?", "No. Doclira is best for practical office tasks, light corrections and conversion workflows, not complex visual PDF redesign."],
  ["What happens after purchase?", "Gumroad delivers an activation key. Download the installer from the website, then activate the app."],
];

const targetUsers = [
  ["Invoices", "Extract line items, totals and table-like data into Excel or CSV while keeping files on Windows.", "/pdf-invoice-to-excel/"],
  ["Statements", "Prepare bank statement PDFs for CSV review instead of uploading financial files online.", "/bank-statement-pdf-to-csv/"],
  ["Sensitive files", "Redact contracts, audit forms and watermark office PDFs before sharing them externally.", "/redact-sensitive-information-pdf/"],
];
---

<Layout
  title="Doclira PDF - Offline PDF to Excel, Redaction and Batch Tools for Windows"
  description="Convert invoices, statements and tables from PDF to Excel or CSV workflows locally on Windows. Redact sensitive data, watermark, compress, merge and split PDFs."
>
  <Header />
  <main>
    <section class="hero">
      <div class="hero-media">
        <img src="/assets/hero_redaction_en.png" alt="Doclira PDF smart redaction preview" />
      </div>
      <div class="hero-content">
        <p class="kicker">OFFLINE PDF TO OFFICE WORKFLOWS</p>
        <h1>Turn sensitive PDFs into clean office files locally.</h1>
        <p class="hero-copy">Doclira PDF helps Windows users extract tables from invoices and statements, convert PDFs, redact private data, watermark batches and process office files without uploading them to random online tools.</p>
        <div class="actions">
          <a class="primary hero-primary" href="/download/">Download Free Windows App</a>
          <a class="secondary" href="/buy/">Buy License</a>
        </div>
        <div class="requirements">
          <span>Free trial included</span>
          <span>Local processing</span>
          <span>{brand.platform}</span>
          <span>Excel / CSV, redaction and batch tools</span>
        </div>
      </div>
    </section>

    <section class="problem-strip" aria-label="PDF privacy problem">
      {targetUsers.map(([title, text, href]) => (
        <article>
          <strong>{title}</strong>
          <p>{text}</p>
          <a href={href}>View workflow</a>
        </article>
      ))}
    </section>

    <section class="trust-strip" aria-label="Doclira purchase flow">
      <div><strong>1</strong><span>Install first</span><p>No payment is needed to download the Windows installer.</p></div>
      <div><strong>2</strong><span>Test the workflow</span><p>Try the app with non-sensitive PDFs and check output quality.</p></div>
      <div><strong>3</strong><span>Activate when ready</span><p>Gumroad delivers the key used inside Doclira PDF.</p></div>
    </section>

    <section id="features" class="band">
      <div class="section-head">
        <p class="kicker">FEATURES</p>
        <h2>Focused on the PDF tasks people repeat every week</h2>
        <p class="intro">The main use case is practical: turn readable PDFs into useful office files, keep sensitive documents local, and handle the conversion, redaction and batch work around them.</p>
      </div>
      <div class="feature-grid">
        {features.map(([title, text], index) => (
          <article>
            <span class="feature-index">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="seo-entry band">
      <div class="section-head">
        <p class="kicker">PDF TASK GUIDES</p>
        <h2>More ways people find Doclira</h2>
        <p class="intro">Each page targets a narrow search intent: invoice extraction, statement CSV workflows, table extraction, local privacy checks, conversion and batch office work.</p>
      </div>
      <div class="tool-link-grid rich">
        {seoPages.map(([title, text, href]) => (
          <a href={href}>
            <strong>{title}</strong>
            <span>{text}</span>
          </a>
        ))}
      </div>
    </section>

    {brand.youtubeVideoId && (
      <section id="demo" class="band">
        <div class="section-head">
          <p class="kicker">SEE IT IN ACTION</p>
          <h2>Watch the walkthrough</h2>
          <p class="intro">Use the video as proof on the website and as a reusable asset for SEO pages and social posts.</p>
        </div>
        <div class="video-wrapper">
          <iframe width="100%" height="450" src={`https://www.youtube.com/embed/${brand.youtubeVideoId}`} title="Doclira PDF demo" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </section>
    )}

    <section id="workflow" class="workflow">
      <div class="section-head">
        <p class="kicker">WORKFLOW</p>
        <h2>From source file to output in four steps</h2>
      </div>
      <ol>
        {steps.map((step, index) => <li><span>{index + 1}</span><p>{step}</p></li>)}
      </ol>
      <a class="text-link" href="/guide/">Read the full user guide</a>
    </section>

    <section id="pricing" class="pricing">
      <div>
        <p class="kicker">HOW PURCHASE WORKS</p>
        <h2>The installer is free. Payment unlocks the license.</h2>
        <p class="pricing-note">This avoids confusion after checkout: users install Doclira PDF from the website, then paste the Gumroad activation key in the app. AI credits are visible and can be topped up later.</p>
      </div>
      <div class="purchase-flow">
        <article>
          <span>1</span>
          <h3>Free installer</h3>
          <p>Download and install the same Windows app used by every license level.</p>
          <a class="secondary wide" href="/download/">Download app</a>
        </article>
        <article>
          <span>2</span>
          <h3>Activation key</h3>
          <p>Buy a license or AI credit pack on Gumroad, then activate inside the app.</p>
          <a class="primary wide" href="/buy/">Compare options</a>
        </article>
      </div>
    </section>

    <section id="faq" class="faq">
      <div class="section-head">
        <p class="kicker">FAQ</p>
        <h2>Clear expectations, fewer surprises</h2>
      </div>
      <div class="faq-grid">
        {faq.map(([question, answer]) => <article><h3>{question}</h3><p>{answer}</p></article>)}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
