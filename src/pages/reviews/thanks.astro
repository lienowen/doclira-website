---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Feedback Received - Doclira PDF"
  description="Thank you for sending feedback about Doclira PDF."
>
  <Header />
  <main class="guide-page">
    <section class="guide-intro">
      <p class="kicker">THANK YOU</p>
      <h1>Your feedback was sent.</h1>
      <p>We will review your message and use it to improve Doclira PDF. If your note is about a support issue, please allow some time for a reply.</p>
      <div class="actions page-actions">
        <a class="primary" href="/">Back to homepage</a>
        <a class="secondary" href="/support/">Contact support</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
