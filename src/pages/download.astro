---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { brand } from "../brand.js";

const downloads = [
  {
    name: "Doclira PDF Lite",
    tag: "Free",
    platform: "Windows 10 / 11, 64-bit",
    bestFor: "Trying the basic interface and PDF workflow.",
    delivery: "Public GitHub repository",
    action: "Download Lite",
    href: brand.liteUrl,
    primary: true,
  },
  {
    name: "Doclira PDF Pro",
    tag: brand.price,
    platform: "Windows 10 / 11, 64-bit",
    bestFor: "Daily PDF work, batch tools and AI document help.",
    delivery: "Installer and license key after Gumroad checkout",
    action: "Buy Pro",
    href: brand.purchaseUrl,
  },
  {
    name: "User Guide",
    tag: "Guide",
    platform: "Online",
    bestFor: "Installation, activation and common workflow steps.",
    delivery: "Website guide",
    action: "Open Guide",
    href: "/guide/",
  },
];
---

<Layout
  title="Download Doclira PDF - Windows PDF Toolkit"
  description="Download Doclira PDF Lite, purchase the full Windows edition, or open the user guide."
>
  <Header />
  <main class="download-page">
    <section class="download-hero">
      <p class="kicker">DOWNLOAD</p>
      <h1>Download Doclira PDF</h1>
      <p>Choose the free Lite edition, purchase the full Windows toolkit, or open the guide.</p>
    </section>

    <section class="download-list" aria-label="Doclira PDF download options">
      {downloads.map((item) => (
        <article class="download-row">
          <div>
            <span class="download-tag">{item.tag}</span>
            <h2>{item.name}</h2>
            <p>{item.bestFor}</p>
          </div>
          <div>
            <span>System</span>
            <strong>{item.platform}</strong>
          </div>
          <div>
            <span>Delivery</span>
            <strong>{item.delivery}</strong>
          </div>
          <a class={item.primary ? "primary" : "secondary"} href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noreferrer" : undefined}>{item.action}</a>
        </article>
      ))}
    </section>

    <section class="download-note">
      <h2>Recommended first step</h2>
      <p>New users should try Lite first with non-sensitive PDFs. If the workflow fits your office tasks, use the paid edition for commercial work, batch processing and AI credits.</p>
    </section>
  </main>
  <Footer />
</Layout>
