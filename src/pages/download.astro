---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { brand } from "../brand.js";

const downloads = [
  {
    name: "Doclira PDF Windows Installer",
    tag: "Installer",
    platform: "Windows 10 / 11, 64-bit",
    bestFor: "Install the app first, then use free features or activate a paid plan.",
    delivery: "Direct installer / release download",
    action: "Download Installer",
    href: brand.installerUrl,
    primary: true,
  },
  {
    name: "Activation Key",
    tag: brand.price,
    platform: "Windows 10 / 11, 64-bit",
    bestFor: "Unlock paid batch tools, commercial use and included AI credits.",
    delivery: "Gumroad license key",
    action: "Buy License",
    href: brand.purchaseUrl,
  },
  {
    name: "AI Credits",
    tag: "Add-on",
    platform: "Activated app",
    bestFor: "Add more AI document credits after the included credits are used.",
    delivery: "Gumroad credit key",
    action: "Buy Credits",
    href: brand.aiCreditsUrl,
  },
  {
    name: "User Guide",
    tag: "Guide",
    platform: "Online",
    bestFor: "Installation, activation and common workflow steps.",
    delivery: "Website guide",
    action: "Open Guide",
    href: "/guide/",
  },
];
---

<Layout
  title="Download Doclira PDF - Windows PDF Toolkit"
  description="Download the Doclira PDF Windows installer, buy an activation key, or open the user guide."
>
  <Header />
  <main class="download-page">
    <section class="download-hero">
      <p class="kicker">DOWNLOAD</p>
      <h1>Download Doclira PDF</h1>
      <p>The installer is separate from purchase. Download the Windows app first; payment only provides the activation key and optional AI credit keys.</p>
    </section>

    <section class="download-list" aria-label="Doclira PDF download options">
      {downloads.map((item) => (
        <article class="download-row">
          <div>
            <span class="download-tag">{item.tag}</span>
            <h2>{item.name}</h2>
            <p>{item.bestFor}</p>
          </div>
          <div>
            <span>System</span>
            <strong>{item.platform}</strong>
          </div>
          <div>
            <span>Delivery</span>
            <strong>{item.delivery}</strong>
          </div>
          <a class={item.primary ? "primary" : "secondary"} href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noreferrer" : undefined}>{item.action}</a>
        </article>
      ))}
    </section>

    <section class="download-note">
      <h2>Recommended first step</h2>
      <p>New users should install Doclira PDF and test non-sensitive PDFs first. If the workflow fits your office tasks, buy a license key to unlock the paid plan.</p>
    </section>
  </main>
  <Footer />
</Layout>
