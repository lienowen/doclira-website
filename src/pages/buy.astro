---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { brand } from "../brand.js";
---

<Layout
  title="Buy Doclira PDF - Local PDF to CSV and Redaction License"
  description="Buy a Doclira PDF activation key for local invoice and statement PDF to CSV workflows, redaction, PDF audit and batch Windows tools."
>
  <Header />
  <main class="policy-page">
    <section class="policy-hero buy-hero">
      <div>
        <p class="kicker">BUY LICENSE</p>
        <h1>Unlock local PDF to CSV, redaction and batch workflows.</h1>
        <p>Doclira PDF is packaged for people who handle invoices, statements, contracts and client files. Download the installer first, test with a sample PDF, then use the Gumroad key to unlock paid tools inside the app.</p>
        <div class="actions">
          <a class="primary" href={brand.purchaseUrl} target="_blank" rel="noreferrer">Open Gumroad checkout</a>
          <a class="secondary" href="/download/">Download installer first</a>
        </div>
      </div>
      <aside class="checkout-card">
        <span>Purchase flow</span>
        <ol>
          <li>Download Doclira PDF from this website.</li>
          <li>Test CSV export, redaction and batch workflows.</li>
          <li>Buy on Gumroad and paste the activation key in the app.</li>
        </ol>
        <p>Keep the Gumroad receipt. It is your delivery record.</p>
      </aside>
    </section>

    <section class="band">
      <div class="section-head">
        <p class="kicker">LICENSE OPTIONS</p>
        <h2>Choose the license by document workload.</h2>
        <p class="intro">Every plan uses the same installer. The key unlocks local CSV extraction, privacy workflows, batch tools and included AI credits.</p>
      </div>
      <div class="tier-grid">
        {brand.pricing.map((plan) => (
          <article class:list={["tier-card", plan.highlight && "highlight"]}>
            {plan.highlight && <span class="tier-badge">Best for teams</span>}
            <h3>{plan.name}</h3>
            <p class="tier-price">{plan.price}</p>
            <ul>
              <li>Invoice and statement PDF to CSV workflows</li>
              <li>Redaction, PDF security audit, watermark, convert, compress, merge and split</li>
              <li>Batch tools for repeated office documents</li>
              <li>Local PDF processing; AI is optional and uses extracted text only when used</li>
              <li>{plan.ai}</li>
              <li>Activation key delivered by Gumroad after checkout</li>
            </ul>
            <a class="primary wide" href={plan.url} target="_blank" rel="noreferrer">{plan.cta}</a>
          </article>
        ))}
      </div>
    </section>

    <section id="ai-credits" class="band soft-band">
      <div class="section-head">
        <p class="kicker">AI CREDIT PACKS</p>
        <h2>Optional: add AI credits later.</h2>
        <p class="intro">Doclira is sold as a PDF toolkit first. AI credits are only for optional summaries, translation and document Q&A when you choose to use AI.</p>
      </div>
      <div class="credit-grid">
        {brand.creditPacks.map((pack) => (
          <article class:list={[pack.highlight && "highlight"]}>
            {pack.highlight && <span class="tier-badge">Popular top-up</span>}
            <h3>{pack.name}</h3>
            <p class="tier-price">{pack.price}</p>
            <strong>{pack.credits}</strong>
            <p>{pack.use}</p>
          </article>
        ))}
      </div>
      <div class="center-actions">
        <a class="primary" href={brand.aiCreditsUrl} target="_blank" rel="noreferrer">Buy AI credits on Gumroad</a>
      </div>
    </section>

    <section class="faq compact-faq">
      <div class="section-head">
        <p class="kicker">PURCHASE NOTES</p>
        <h2>What buyers should know before checkout</h2>
      </div>
      <div class="faq-grid">
        <article><h3>Is the installer included in Gumroad?</h3><p>No. Download the installer from doclira.com. Gumroad delivers the activation key.</p></article>
        <article><h3>Can I test before buying?</h3><p>Yes. Install the app first and test with sample or non-sensitive PDFs before purchasing.</p></article>
        <article><h3>Are credits monthly?</h3><p>No. Credits are a visible balance. They are consumed when AI tasks run successfully.</p></article>
        <article><h3>Where do I ask for help?</h3><p>Use the support and feedback pages, or email {brand.supportEmail} with your order email and issue details.</p></article>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
