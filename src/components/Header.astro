---
import { brand } from "../brand.js";
const { locale = "en" } = Astro.props;
const isZh = locale === "zh";
const prefix = isZh ? "/zh" : "";
const guide = isZh ? "/zh/guide/" : "/guide/";
const swap = isZh ? "/" : "/zh/";
---

<header class="topbar">
  <a class="brand" href={`${prefix}/`} aria-label={`${brand.product} homepage`}>
    <span class="brand-mark">D</span>
    <span>{brand.product}</span>
  </a>
  <nav aria-label={isZh ? "导航" : "Primary"}>
    <a href={`${prefix}/#features`}>{isZh ? "功能" : "Features"}</a>
    <a href={guide}>{isZh ? "使用指南" : "Guide"}</a>
    <a href={`${prefix}/#faq`}>{isZh ? "常见问题" : "FAQ"}</a>
    <a class="language-link" href={swap}>{isZh ? "EN" : "中文"}</a>
    <a class="nav-buy" href={brand.purchaseUrl} target="_blank" rel="noreferrer">{isZh ? "立即购买" : "Buy now"}</a>
  </nav>
</header>
