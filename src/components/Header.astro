---
import { brand } from "../brand.js";

const { locale = "en" } = Astro.props;
const isZh = locale === "zh";
const prefix = isZh ? "/zh" : "";
const guide = isZh ? "/zh/guide/" : "/guide/";
const download = isZh ? "/zh/download/" : "/download/";
const swap = isZh ? "/" : "/zh/";
---

<header class="topbar">
  <a class="brand" href={`${prefix}/`} aria-label={`${brand.product} homepage`}>
    <span class="brand-mark">D</span>
    <span>{brand.product}</span>
  </a>
  <nav aria-label="Primary navigation">
    <a href={`${prefix}/#features`}>{isZh ? "Features" : "Features"}</a>
    <a href={download}>{isZh ? "Download" : "Download free"}</a>
    <a href={guide}>{isZh ? "Guide" : "Guide"}</a>
    <a href="/feedback/">{isZh ? "Feedback" : "Feedback"}</a>
    <a href={`${prefix}/#faq`}>FAQ</a>
    <a class="language-link" href={swap}>{isZh ? "EN" : "中文"}</a>
    <a class="nav-buy" href={brand.purchaseUrl} target="_blank" rel="noreferrer">{isZh ? "Buy now" : "Buy now"}</a>
  </nav>
</header>
