---
import { brand } from "../brand.js";

const { locale = "en" } = Astro.props;
const isZh = locale === "zh";
---

<footer>
  <div class="brand footer-brand">
    <span class="brand-mark">D</span>
    <span>{brand.product}</span>
  </div>
  <p>{isZh ? "适合 Windows 的实用 PDF 工具，核心处理留在本机完成。" : "Practical PDF tools for Windows. Core processing stays on your device."}</p>
  {brand.supportEmail ? <a href={`mailto:${brand.supportEmail}`}>{brand.supportEmail}</a> : <span class="footer-pending">{isZh ? "上线时添加支持邮箱" : "Support contact added at launch"}</span>}
</footer>
