---
import { brand } from "../brand.js";

const { locale = "en" } = Astro.props;
const isZh = locale === "zh";
const prefix = isZh ? "/zh" : "";
---

<footer>
  <div class="brand footer-brand">
    <span class="brand-mark">D</span>
    <span>{brand.product}</span>
  </div>
  <p>
    {isZh
      ? "面向日常办公的 Windows PDF 工具。核心处理在本机完成，AI 功能需要联网。"
      : "Practical Windows PDF tools for everyday office work. Core processing stays on your device; AI features use an online service."}
  </p>
  <div class="footer-links">
    <a href={`${prefix}/download/`}>{isZh ? "下载" : "Download"}</a>
    <a href={`${prefix}/buy/`}>{isZh ? "购买" : "Buy"}</a>
    <a href={`${prefix}/reviews/`}>{isZh ? "评论" : "Reviews"}</a>
    <a href={`${prefix}/support/`}>{isZh ? "支持" : "Support"}</a>
    <a href={`${prefix}/refund/`}>{isZh ? "退款政策" : "Refund Policy"}</a>
    <a href={`${prefix}/privacy/`}>{isZh ? "隐私说明" : "Privacy"}</a>
    <a href={`mailto:${brand.supportEmail}`}>{brand.supportEmail}</a>
  </div>
</footer>
