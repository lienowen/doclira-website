---
import { brand } from "../brand.js";

const { locale = "en" } = Astro.props;
const isZh = locale === "zh";
---

<footer>
  <div class="brand footer-brand">
    <span class="brand-mark">D</span>
    <span>{brand.product}</span>
  </div>
  <p>{isZh ? "Practical PDF tools for Windows. Core processing stays on your device." : "Practical PDF tools for Windows. Core processing stays on your device."}</p>
  <div class="footer-links">
    <a href="/feedback/">Feedback</a>
    <a href="/support/">Support</a>
    {brand.supportEmail ? <a href={`mailto:${brand.supportEmail}`}>{brand.supportEmail}</a> : <span class="footer-pending">Support contact added at launch</span>}
  </div>
</footer>
